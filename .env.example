# Anthropic API configuration
ANTHROPIC_API_KEY=sk-ant-...your-key-here...

# Database configuration (matches docker-compose.yml)
DATABASE_URL=postgresql+psycopg2://autoad:autoad@localhost:5432/autoad_dev

# AWS configuration (for phase 4 deployment)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-key-id
AWS_SECRET_ACCESS_KEY=your-secret-key

# Application configuration
LOG_LEVEL=INFO
ENVIRONMENT=development

# Model selection. Sonnet for quality (generation/extraction); Haiku for
# cheap, high-volume extraction and eval passes. Provider-swappable.
LLM_MODEL_GENERATION=claude-sonnet-4-6
LLM_MODEL_EXTRACTION=claude-sonnet-4-6
LLM_MODEL_EXTRACTION_CHEAP=claude-haiku-4-5-20251001
